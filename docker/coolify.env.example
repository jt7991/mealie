# Runtime variables in Coolify. Do not enable Build Variable for credentials.
BASE_URL=https://YOUR_MEALIE_DOMAIN
ALLOW_SIGNUP=true
ALLOW_PASSWORD_LOGIN=true
MAGIC_LINK_ENABLED=true
TOKEN_TIME=8760
DB_ENGINE=sqlite
DATA_DIR=/app/data
TZ=America/New_York
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_AUTH_STRATEGY=SSL
SMTP_USER=resend
SMTP_PASSWORD=YOUR_RESEND_API_KEY
SMTP_FROM_NAME=Mealie
SMTP_FROM_EMAIL=recipes@jakey.fyi
